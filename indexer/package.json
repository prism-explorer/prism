{
  "name": "prism-indexer",
  "version": "0.1.0",
  "description": "Forward-only indexer for Prism: persists Soroban contract storage changes, invocations, and events to Postgres so the explorer isn't limited to the RPC node's retention window.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "backfill": "node dist/backfill.js",
    "backfill:dev": "tsx src/backfill.ts",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "dependencies": {
    "@prism/scval-display": "file:../packages/scval-display",
    "@prisma/client": "^7.10.1",
    "@stellar/stellar-sdk": "^17.4.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
