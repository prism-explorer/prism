{
  "name": "prism-indexer",
  "version": "0.1.0",
  "description": "Forward-only indexer for Prism: persists Soroban contract storage changes, invocations, and events to Postgres so the explorer isn't limited to the RPC node's retention window.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1",
    "@stellar/stellar-sdk": "^17.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
