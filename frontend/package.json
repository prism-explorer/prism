{
  "name": "prism",
  "version": "0.1.0",
  "description": "Open-source Soroban-native block explorer for the Stellar network",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "keywords": [
    "stellar",
    "soroban",
    "explorer",
    "blockchain",
    "prism"
  ],
  "license": "MIT",
  "dependencies": {
    "@prism/scval-display": "file:../packages/scval-display",
    "@stellar/js-xdr": "^5.0.0",
    "@stellar/stellar-sdk": "^17.4.0",
    "ioredis": "^6.0.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.9",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
