# Stellar network: "testnet", "mainnet", or "futurenet".
# This is the only variable you have to set — the endpoints below default to
# the matching public endpoints for whichever network you pick.
NEXT_PUBLIC_NETWORK=testnet

# Horizon REST API endpoint. Override to use your own node.
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint (for contract data). Override to use your own node.
# If an endpoint's hostname disagrees with NEXT_PUBLIC_NETWORK above, Prism
# shows a warning banner rather than serving one network's data under
# another's name.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Public site URL, used to resolve absolute OG/social image URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
